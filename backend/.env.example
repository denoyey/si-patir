# Server Port
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sipatir_db
DB_PORT=3306

# Discord Webhook URL (Ambil dari Discord Channel Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# Trello API Configuration (Ambil dari https://trello.com/app-key)
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
TRELLO_BOARD_ID=your_trello_board_id
TRELLO_DONE_LIST_ID=your_trello_done_list_id

# GitHub Configuration
GITHUB_REPO=denoyey/si-patir
GITHUB_WEBHOOK_SECRET=sipatir_secret_123

